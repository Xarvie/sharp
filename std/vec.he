#include "types.he"
#include <stdbool.h>
#include <stdlib.h>

class Vec<T> {
    T*    data;
    isize len;
    isize cap;
}

static inline void Vec<T>.push(this, T val) {
    if (this->len >= this->cap) {
        isize new_cap = (this->cap == 0) ? 8 : this->cap * 2;
        T* nd = (T*)realloc(this->data, sizeof(T) * new_cap);
        if (!nd) __builtin_trap();
        this->data = nd;
        this->cap = new_cap;
    }
    this->data[this->len] = val;
    this->len = this->len + 1;
}

static inline T Vec<T>.pop(this) {
    if (this->len == 0) __builtin_trap();
    this->len = this->len - 1;
    return this->data[this->len];
}

static inline T Vec<T>.get(this, isize i) const {
    if (i < 0 || i >= this->len) __builtin_trap();
    return this->data[i];
}

static inline T* Vec<T>.get_ptr(this, isize i) {
    if (i < 0 || i >= this->len) __builtin_trap();
    return &this->data[i];
}

static inline void Vec<T>.set(this, isize i, T val) {
    if (i < 0 || i >= this->len) __builtin_trap();
    this->data[i] = val;
}

static inline T Vec<T>.operator[](this, isize i) const {
    if (i < 0 || i >= this->len) __builtin_trap();
    return this->data[i];
}

static inline isize Vec<T>.size(this) const {
    return this->len;
}

static inline isize Vec<T>.capacity(this) const {
    return this->cap;
}

static inline bool Vec<T>.is_empty(this) const {
    return this->len == 0;
}

static inline void Vec<T>.reserve(this, isize n) {
    if (n <= this->cap) return;
    T* nd = (T*)realloc(this->data, sizeof(T) * n);
    if (!nd) __builtin_trap();
    this->data = nd;
    this->cap = n;
}

static inline void Vec<T>.clear(this) {
    this->len = 0;
}

static inline void Vec<T>.destroy(this) {
    free(this->data);
    this->data = (T*)0;
    this->len = 0;
    this->cap = 0;
}