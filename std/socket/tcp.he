/*
 * libtcp — Sharp 网络库第三层: TCP (基于 socket)
 *
 * 设计原则:
 *   - tcp_listener_t / tcp_stream_t 是栈上 32B 不透明结构体, 不 malloc
 *   - 所有创建的 socket 自动设为非阻塞 (nonblock + reuseaddr)
 *   - 通过 tcp_xxx_socket() 暴露 socket_t, 供 poller_ctl 注册
 *   - accept / dial 返回句柄 + out_err, I/O 返回 socket_io_result_t
 *   - 字符串走 ptr + len, 无 \0 依赖
 *   - 一个 .h + 一个 .c, 平台无关 (全部复用 socket 层的平台适配)
 *
 * 异步 dial 正确流程:
 *   tcp_stream_t s = tcp_dial("host", 4, 8080, 0, &err);
 *   if (err == SOCKET_ERR_INPROGRESS || err == SOCKET_ERR_AGAIN) {
 *       poller_ctl(p, POLLER_CTL_ADD, tcp_stream_socket(&s), POLLER_OUT, (uint64_t)s_idx);
 *       // ... wait for POLLER_OUT, then:
 *       int so_err = socket_get_error(tcp_stream_socket(&s));
 *       if (so_err != SOCKET_OK) { tcp_stream_close(&s); // connect failed }
 *   }
 *
 * ET 模式 + 固定缓冲区陷阱:
 *   使用 POLLER_ET (边缘触发) 时, 必须持续 recv 直到返回 EAGAIN,
 *   否则内核不会再次通知 POLLER_IN, 数据永远丢失.
 *   当 ringbuf 容量不足时, 用 tcp_drain() 可以安全读空内核缓冲区;
 *   如果 ringbuf 先满 (drained=0), 用户需自行扩容或降级为 LT 模式.
 *
 * 幽灵事件 (Dangling Event) 提醒:
 *   poller 批量返回事件后, 处理第 N 个事件时可能已关闭了第 M (M<N) 个 fd.
 *   如果 OS 立即复用该 fd, 后续事件中残留的 user_data 将指向错误上下文.
 *   解决方案: 在应用层事件循环中为每个连接分配 Generation/Epoch 编号,
 *   user_data 编码为 (fd_index | epoch<<32), 处理事件时先校验 epoch.
 *
 * 优雅关闭 (Graceful Shutdown) 推荐序列:
 *   1. tcp_shutdown_write(&s)  → 发送 FIN, 对端知道不再有数据
 *   2. 继续 tcp_recv 直到返回 0 (对端 FIN) 或错误
 *   3. socket_set_linger(tcp_stream_socket(&s), 1, 5)  → 等待发送缓冲排空
 *   4. tcp_stream_close(&s)    → 物理关闭
 *
 * 典型用法 (echo server):
 *   tcp_listener_t ln = TCP_LISTENER_INIT;
 *   int err = tcp_listen(&ln, NULL, 0, 8080, 128, SOCKET_AF_INET);
 *   if (err) { ... }
 *
 *   poller_t p = poller_create(&err);
 *   // 把 listener socket 本身作为 user_data, 便于事件分发时识别
 *   poller_ctl(p, POLLER_CTL_ADD, tcp_listener_socket(&ln),
 *              POLLER_IN, (uint64_t)(intptr_t)tcp_listener_socket(&ln));
 *
 *   for (;;) {
 *       poller_event_t evs[64];
 *       int n = poller_wait(p, evs, 64, -1);
 *       for (int i = 0; i < n; i++) {
 *           socket_t sock = (socket_t)(intptr_t)evs[i].user_data;
 *           if (sock == tcp_listener_socket(&ln)) {
 *               // 新连接到达
 *               tcp_stream_t s = tcp_accept(&ln, NULL, &err);
 *               if (err) continue;
 *               // 将 stream 存入连接表, 如 stream_map[tcp_stream_socket(&s)] = s;
 *               // ET 模式谨慎使用; 如用 LT (不加 POLLER_ET) 则无死锁风险
 *               poller_ctl(p, POLLER_CTL_ADD, tcp_stream_socket(&s),
 *                          POLLER_IN, (uint64_t)(intptr_t)tcp_stream_socket(&s));
 *           } else {
 *               // 已连接 stream 可读, 通过 sock 查表找到对应 stream
 *               // 推荐用 tcp_drain() 安全读空内核缓冲区
 *               socket_io_result_t r = tcp_recv(find_stream(sock), ...);
 *           }
 *       }
 *   }
 */

#ifndef SHARP_TCP_H
#define SHARP_TCP_H

#include <stddef.h>
#include <stdint.h>

#include "socket.he"
#include "ringbuf.he"

#ifdef __cplusplus
extern "C" {
#endif

/* ========================================================================
 * 值类型 — 栈上分配, 零 malloc
 *
 * 这些是对外暴露的不透明结构体. .c 内的真实结构体必须 <= 此大小,
 * 否则会栈溢出. 实现文件中必须加静态断言:
 *   _Static_assert(sizeof(real_t) <= sizeof(tcp_listener_t),
 *                  "tcp_listener_t size overflow!");
 * ======================================================================== */

typedef struct { uint64_t opaque[4]; } tcp_listener_t;
typedef struct { uint64_t opaque[4]; } tcp_stream_t;

#define TCP_LISTENER_INIT ((tcp_listener_t){{SOCKET_INVALID}})
#define TCP_STREAM_INIT    ((tcp_stream_t){{SOCKET_INVALID}})

/* ========================================================================
 * Listener
 * ======================================================================== */

/**
 * 创建非阻塞 TCP 监听 socket, 绑定到指定 IP 并开始监听.
 * ip 可为 NULL (绑定到所有接口). 自动设置 SO_REUSEADDR + O_NONBLOCK.
 *
 * 成功: ln 被填充, 返回 SOCKET_OK (0).
 * 失败: ln 保持 TCP_LISTENER_INIT, 返回错误码 (>0).
 */
int tcp_listen(tcp_listener_t* ln,
               const char* ip, size_t ip_len,
               uint16_t port, int backlog, int family);

#ifndef _WIN32
/**
 * Unix domain socket 监听.
 * path: 文件系统路径 (sockaddr_un.sun_path). 自动 unlink 已存在的 socket 文件.
 * path_len: 路径长度.
 * backlog: listen backlog.
 * 成功返回 0 / err.
 */
int tcp_listen_unix(tcp_listener_t* ln,
                    const char* path, size_t path_len,
                    int backlog);
#endif

/**
 * 获取 listener 底层 socket_t, 用于 poller_ctl 注册 POLLER_IN 等事件.
 * ln 必须已通过 tcp_listen 成功初始化.
 */
socket_t tcp_listener_socket(const tcp_listener_t* ln);

/**
 * 获取 listener 绑定的本地地址 (调用 getsockname).
 * 成功返回 0, 失败返回错误码 (>0).
 */
int tcp_listener_addr(const tcp_listener_t* ln, socket_addr_t* out_addr);

/**
 * 关闭 listener 及其底层 socket, 恢复为 TCP_LISTENER_INIT.
 * 已关闭的 listener 重复调用无害.
 */
void tcp_listener_close(tcp_listener_t* ln);

/* ========================================================================
 * Accept
 * ======================================================================== */

/**
 * 接受一个 TCP 连接.
 * peer 可为 NULL (不获取对端地址).
 *
 * 成功返回已填充的 tcp_stream_t (非阻塞), *out_err = 0.
 * 失败返回 TCP_STREAM_INIT, *out_err = 错误码
 *   (非阻塞 socket 返回 SOCKET_ERR_AGAIN 时, 应通过 poller 等待 POLLER_IN).
 */
tcp_stream_t tcp_accept(tcp_listener_t* ln, socket_addr_t* peer,
                        int* out_err);

/* ========================================================================
 * Dial (客户端连接)
 * ======================================================================== */

/**
 * 创建非阻塞 TCP 客户端 socket 并发起连接到远端地址.
 * family: SOCKET_AF_INET / SOCKET_AF_INET6 / 0 (自动).
 *
 * 返回值约定:
 *   out_err = SOCKET_OK (0)           → connect 立即完成 (极少见);
 *   out_err = SOCKET_ERR_INPROGRESS   → 连接进行中 (POSIX), 返回有效 stream;
 *   out_err = SOCKET_ERR_AGAIN        → 连接进行中 (Windows), 返回有效 stream;
 *   out_err = 其他错误码              → 连接失败, 返回 TCP_STREAM_INIT.
 *
 * 异步连接确认: POLLER_OUT 触发后必须调用 socket_get_error() 确认成功,
 * 不可依赖 getsockname / getpeername (连接失败时可能仍返回有效地址).
 *   int so_err = socket_get_error(tcp_stream_socket(&s));
 *   if (so_err != SOCKET_OK) { // connect failed }
 */
tcp_stream_t tcp_dial(const char* host, size_t host_len,
                      uint16_t port, int family,
                      int* out_err);

/**
 * 同上, 但使用已构造好的 socket_addr_t 作为目标地址.
 * 同样遵循 INPROGRESS/AGAIN 语义: 返回有效 stream 后用 socket_get_error() 确认.
 */
tcp_stream_t tcp_dial_addr(const socket_addr_t* addr, int* out_err);

/**
 * dial with timeout — 封装异步 dial + poller_wait + socket_get_error.
 * timeout_ms: 等待连接完成的超时毫秒数 (-1 = 无限).
 * 返回已确认连接的 stream, out_err = SOCKET_OK 表示连接成功.
 * 失败返回 TCP_STREAM_INIT, out_err 为具体错误码.
 */
tcp_stream_t tcp_dial_timeout(const char* host, size_t host_len,
                              uint16_t port, int family,
                              int timeout_ms, int* out_err);

/* ========================================================================
 * Stream I/O
 * ======================================================================== */

/**
 * 获取 stream 底层 socket_t, 用于 poller_ctl 注册 POLLER_IN / POLLER_OUT.
 */
socket_t tcp_stream_socket(const tcp_stream_t* s);

/**
 * 接收数据.
 * s 必须已连接.
 * 返回 socket_io_result_t: nbytes >= 0 成功, < 0 失败 (含 AGAIN 等).
 */
socket_io_result_t tcp_recv(tcp_stream_t* s, void* buf, size_t len);

/**
 * 发送数据.
 * s 必须已连接.
 * 返回 socket_io_result_t: nbytes >= 0 成功, < 0 失败.
 */
socket_io_result_t tcp_send(const tcp_stream_t* s, const void* buf, size_t len);

/**
 * 非阻塞全量发送 — 循环调用 tcp_send 直到发送完所有数据或遇到错误.
 * s 必须已连接且非阻塞.
 * 遇到 EAGAIN 时会自动 poll 等待 POLLER_OUT 后重试.
 * 注意: 每次 EAGAIN 会创建/销毁 poller (轻量, 但高频场景建议自建复用的 poller).
 * 返回 socket_io_result_t: nbytes 可能 < len (对端关闭等), < 0 错误.
 */
socket_io_result_t tcp_send_all(const tcp_stream_t* s,
                                const void* buf, size_t len);

/**
 * ET 模式下安全读空内核缓冲区直到 EAGAIN.
 * 将读取数据追加写入 ringbuf (零拷贝, reserve/commit 直达 recv 缓冲区).
 *
 * 返回读取总字节数 (>= 0, 可能为 0 表示尚未就绪).
 * 如果 ringbuf 在读到 EAGAIN 之前先满, *drained = 0 表示内核中仍有未读数据 —
 * ET 模式下这意味着丢失 POLLER_IN 通知. 调用者应扩容 ringbuf 或降级为 LT 模式.
 *
 * 正常情况下 *drained = 1 (已读到 EAGAIN, 内核缓冲区完全排空).
 * s 或 rb 为 NULL / invalid 时返回 -1.
 */
ptrdiff_t tcp_drain(tcp_stream_t* s, ringbuf_t* rb, int* drained);

/**
 * 关闭 TCP 写入端 (发送 FIN).
 * 返回 0 / err.
 */
int tcp_shutdown_write(tcp_stream_t* s);

/**
 * 设置 socket 选项 — TCP 层直接封装, 不穿透到 socket 层.
 * keepalive:  1 = 开启 TCP keep-alive 探测.
 * nodelay:    1 = 禁用 Nagle 算法 (低延迟).
 * 返回 0 / err.
 */
int tcp_set_keepalive(const tcp_stream_t* s, int keepalive);
int tcp_set_nodelay(const tcp_stream_t* s, int nodelay);
int tcp_set_defer_accept(const tcp_stream_t* s, int enable);

/**
 * 读满 len 字节才返回 — 协议解析常用.
 * 遇到 EAGAIN 会自动 poll 等待 POLLER_IN 后重试.
 * 返回 socket_io_result_t: nbytes > 0 (可能 < len 对端关闭), < 0 错误.
 */
socket_io_result_t tcp_recv_exact(tcp_stream_t* s, void* buf, size_t len);

/* ========================================================================
 * Stream 地址 — 底层调用 getpeername / getsockname, 可能失败
 * ======================================================================== */

/** 获取对端地址. 成功返回 0, 失败返回错误码 (如 SOCKET_ERR_NOTCONN). */
int tcp_peer_addr(const tcp_stream_t* s, socket_addr_t* out_addr);

/** 获取本地地址. 成功返回 0, 失败返回错误码 (>0). */
int tcp_local_addr(const tcp_stream_t* s, socket_addr_t* out_addr);

/* ========================================================================
 * Stream 关闭
 * ======================================================================== */

/**
 * 关闭 stream 及其底层 socket, 恢复为 TCP_STREAM_INIT.
 * 已关闭的 stream 重复调用无害.
 */
void tcp_stream_close(tcp_stream_t* s);

#ifdef __cplusplus
}
#endif

#endif /* SHARP_TCP_H */