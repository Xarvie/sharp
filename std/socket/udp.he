/*
 * libudp — Sharp 网络库第三层: UDP (基于 socket + poller)
 *
 * 设计原则:
 *   - udp_t 是栈上 32B 不透明结构体, 不 malloc
 *   - 创建的 socket 自动设为非阻塞 (nonblock)
 *   - 通过 udp_socket() 暴露 socket_t, 供 poller_ctl 注册
 *   - I/O 返回 socket_io_result_t, 包含 nbytes + err
 *   - 字符串走 ptr + len, 无 \0 依赖
 *   - 一个 .h + 一个 .c, 平台无关 (全部复用 socket 层的平台适配)
 *
 * 典型用法 (echo server):
 *   udp_t u = UDP_INIT;
 *   int err = udp_bind(&u, NULL, 0, 8080, SOCKET_AF_INET);
 *   if (err) { ... }
 *
 *   poller_t p = poller_create(&err);
 *   poller_ctl(p, POLLER_CTL_ADD, udp_socket(&u), POLLER_IN, 0);
 *
 *   for (;;) {
 *       poller_event_t evs[64];
 *       int n = poller_wait(p, evs, 64, -1);
 *       for (int i = 0; i < n; i++) {
 *           char buf[65536];
 *           socket_addr_t from;
 *           socket_io_result_t r = udp_recvfrom(&u, buf, sizeof(buf), &from);
 *           if (r.nbytes > 0) {
 *               udp_sendto(&u, buf, (size_t)r.nbytes, &from);
 *           }
 *       }
 *   }
 */

#ifndef SHARP_UDP_H
#define SHARP_UDP_H

#include <stddef.h>
#include <stdint.h>

#include "socket.he"

#ifdef __cplusplus
extern "C" {
#endif

/* ========================================================================
 * 值类型 — 栈上分配, 零 malloc
 *
 * 这是对外暴露的不透明结构体. .c 内的真实结构体必须 <= 此大小,
 * 否则会栈溢出. 实现文件中必须加静态断言:
 *   _Static_assert(sizeof(real_t) <= sizeof(udp_t),
 *                  "udp_t size overflow!");
 * ======================================================================== */

typedef struct { uint64_t opaque[4]; } udp_t;

#define UDP_INIT ((udp_t){{SOCKET_INVALID}})

/* ========================================================================
 * Bind
 * ======================================================================== */

/**
 * 创建非阻塞 UDP socket 并绑定到指定 IP:port.
 * ip 可为 NULL (绑定到所有接口 = INADDR_ANY / IN6ADDR_ANY).
 * 自动设置 O_NONBLOCK.
 *
 * 成功: u 被填充, 返回 SOCKET_OK (0).
 * 失败: u 保持 UDP_INIT, 返回错误码 (>0).
 */
int udp_bind(udp_t* u,
             const char* ip, size_t ip_len,
             uint16_t port, int family);

#ifndef _WIN32
/**
 * Unix domain datagram socket 绑定.
 * path: 文件系统路径. 自动 unlink 已存在的 socket 文件.
 * path_len: 路径长度.
 * 成功返回 0 / err.
 */
int udp_bind_unix(udp_t* u,
                  const char* path, size_t path_len);
#endif

/**
 * 获取 udp 底层 socket_t, 用于 poller_ctl 注册 POLLER_IN 事件.
 * u 必须已通过 udp_bind 成功初始化.
 */
socket_t udp_socket(const udp_t* u);

/**
 * 获取 udp 绑定的本地地址 (调用 getsockname).
 * 成功返回 0, 失败返回错误码 (>0).
 */
int udp_local_addr(const udp_t* u, socket_addr_t* out_addr);

/* ========================================================================
 * I/O
 * ======================================================================== */

/**
 * 接收一个数据报.
 * from: 出参, 填充发送方地址. 可为 NULL.
 *
 * 返回 socket_io_result_t: nbytes >= 0 成功 (含 nbytes=0 空数据报),
 * nbytes < 0 失败.
 */
socket_io_result_t udp_recvfrom(udp_t* u, void* buf, size_t len,
                                socket_addr_t* from);

/**
 * 发送一个数据报到指定地址.
 * to: 目标地址 (调用者若不指定可用 socket_addr_t 的 broadcast/multicast 地址).
 *
 * 返回 socket_io_result_t: nbytes >= 0 成功, < 0 失败.
 */
socket_io_result_t udp_sendto(const udp_t* u, const void* buf, size_t len,
                              const socket_addr_t* to);

/* ========================================================================
 * Connected UDP — 调用 connect() 绑定默认对端, 无握手开销
 *
 * 适用场景: 游戏服务器等需要长期与固定客户端通信的场景.
 * connect() 后操作系统内核过滤掉非目标来源的包, 且可直接使用
 * send/recv (省去每次 sendto/recvfrom 的地址传参), 吞吐量提升约 30%.
 *
 * 注意: connect 后仍可调用 udp_recvfrom / udp_sendto, 但:
 *   - udp_recvfrom 只接收来自 connect 对端的包 (内核已过滤);
 *   - udp_sendto 会无视 connect 目标, 发给指定地址.
 *   建议 connect 后统一使用 udp_send / udp_recv.
 * ======================================================================== */

/**
 * 将 UDP socket "连接" 到指定对端地址.
 * 不会产生网络握手, 只是在内核中记录默认目标地址.
 * 成功返回 SOCKET_OK (0), 失败返回错误码 (>0).
 */
int udp_connect(udp_t* u, const socket_addr_t* peer);

/**
 * Connected 模式下发数据到已 connect 的对端.
 * 必须先调用 udp_connect.
 * 返回 socket_io_result_t.
 */
socket_io_result_t udp_send(const udp_t* u, const void* buf, size_t len);

/**
 * Connected 模式下接收数据 (只收来自已 connect 对端的包).
 * 必须先调用 udp_connect.
 * 返回 socket_io_result_t.
 */
socket_io_result_t udp_recv(udp_t* u, void* buf, size_t len);

/**
 * 断开 connect 绑定 (恢复为未连接状态).
 * 返回 0 / err.
 */
int udp_disconnect(udp_t* u);

/* ========================================================================
 * 多播 (Multicast)
 * ======================================================================== */

/**
 * 加入多播组.
 * group_ip: 多播组 IP (IPv4 如 "224.0.0.1", IPv6 如 "ff02::1").
 * group_len: IP 字符串长度.
 * 返回 0 / err.
 */
int udp_join_group(udp_t* u, const char* group_ip, size_t group_len);

/**
 * 离开多播组. 参数同 join_group.
 * 返回 0 / err.
 */
int udp_leave_group(udp_t* u, const char* group_ip, size_t group_len);

/**
 * 设置多播 TTL (跳数, IPv4 下为 TTL, IPv6 下为 hop limit).
 * ttl: 0 = 仅本机, 1 = 子网, 默认 1.
 * 返回 0 / err.
 */
int udp_set_multicast_ttl(udp_t* u, int ttl);

/**
 * 设置是否接收自己发出的多播包.
 * enable: 1 = loopback, 0 = no loopback. 默认 1.
 * 返回 0 / err.
 */
int udp_set_multicast_loop(udp_t* u, int enable);

/* ========================================================================
 * 关闭
 * ======================================================================== */

/**
 * 关闭 udp socket, 恢复为 UDP_INIT.
 * 已关闭的 udp 重复调用无害.
 */
void udp_close(udp_t* u);

#ifdef __cplusplus
}
#endif

#endif /* SHARP_UDP_H */