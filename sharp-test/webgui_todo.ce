/* Todo List — test: dynamic children, form submit, remove_self */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "webgui.he"

static wg_node_t *list = NULL;
static int next_id = 1;

typedef struct {
    int item_id;
} item_ud_t;

static void on_del(const wg_event_t *ev);

static void on_add(const wg_event_t *ev) {
    const char *task = wg_form_get(ev, "task");
    if (!task || !*task) return;

    int id = next_id++;

    char item_id[32], txt_id[32], btn_id[32];
    snprintf(item_id, sizeof(item_id), "item_%d", id);
    snprintf(txt_id, sizeof(txt_id), "txt_%d", id);
    snprintf(btn_id, sizeof(btn_id), "del_%d", id);

    /* Create a todo item: [text] [delete button] */
    wg_node_t *item = wg_container(item_id);
    wg_node_t *txt  = wg_text(txt_id, task);
    wg_node_t *btn  = wg_button(btn_id, "X");
    wg_append(item, txt);
    wg_append(item, btn);

    /* Pass item id to callback via userdata */
    item_ud_t *ud = (item_ud_t*)malloc(sizeof(*ud));
    ud->item_id = id;

    wg_on(ev->app, btn_id, "click", on_del, ud);

    wg_append(list, item);
}

static void on_del(const wg_event_t *ev) {
    item_ud_t *ud = (item_ud_t*)ev->userdata;
    if (!ud) return;

    char item_id[32];
    snprintf(item_id, sizeof(item_id), "item_%d", ud->item_id);

    wg_node_t *item = wg_find(ev->app, item_id);
    if (item) {
        wg_remove(list, item);
        wg_free(item);
    }
    free(ud);
}

int main(void) {
    wg_node_t *root = wg_container("root");
    wg_set_attr(root, "style", "max-width:400px;margin:20px auto;");

    wg_node_t *title = wg_heading("title", 2, "Todo List");
    wg_append(root, title);

    /* Input form */
    wg_node_t *form = wg_form("form");
    wg_node_t *input = wg_input("task");
    wg_set_attr(input, "placeholder", "Enter task...");
    wg_node_t *btn   = wg_button("add", "Add");
    wg_set_attr(btn, "role", "submit");
    wg_append(form, input);
    wg_append(form, btn);
    wg_append(root, form);

    /* Todo list container */
    list = wg_container("list");
    wg_set_attr(list, "style", "display:flex;flex-direction:column;gap:4px;margin-top:12px;");
    wg_append(root, list);

    wg_app_t *app = wg_app_create(root);
    if (!app) { fprintf(stderr, "wg_app_create failed\n"); return 1; }
    wg_bind_tcp(app, NULL, 9001);

    wg_set_title(app, "Todo List Demo");

    wg_on(app, "form", "submit", on_add, NULL);

    printf("Open http://localhost:9001 in a browser.\n");
    wg_run(app);
    wg_app_destroy(app);
    return 0;
}
