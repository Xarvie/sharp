/* p161_std_string.sph — std.string definitions */

#include <stdlib.h>

class String {
    char* ptr;
    isize len;
    isize cap;
};

void String.push_byte(this, char c) {
    if (this->len >= this->cap) {
        isize new_cap = (this->cap == 0) ? 8 : this->cap * 2;
        char* nd = (char*)realloc(this->ptr, new_cap);
        if (!nd) __builtin_trap();
        this->ptr = nd;
        this->cap = new_cap;
    }
    this->ptr[this->len] = c;
    this->len = this->len + 1;
}

void String.push_str(this, Str s) {
    if (this->len + s.len > this->cap) {
        bool overlaps = (s.ptr >= this->ptr && s.ptr < this->ptr + this->cap);
        char* tmp = (char*)0;
        isize copy_len = s.len;
        if (overlaps) {
            tmp = (char*)malloc(copy_len);
            if (!tmp) __builtin_trap();
            isize i = 0;
            while (i < copy_len) {
                tmp[i] = s.ptr[i];
                i = i + 1;
            }
            s.ptr = tmp;
        }
        isize new_cap = (this->cap == 0) ? 8 : this->cap * 2;
        while (new_cap < this->len + copy_len) new_cap = new_cap * 2;
        char* nd = (char*)realloc(this->ptr, new_cap);
        if (!nd) { if (tmp) free(tmp); __builtin_trap(); }
        this->ptr = nd;
        this->cap = new_cap;
        isize i = 0;
        while (i < copy_len) {
            this->ptr[this->len + i] = s.ptr[i];
            i = i + 1;
        }
        this->len = this->len + copy_len;
        if (tmp) free(tmp);
    } else {
        isize i = 0;
        while (i < s.len) {
            this->ptr[this->len + i] = s.ptr[i];
            i = i + 1;
        }
        this->len = this->len + s.len;
    }
}

Str String.as_str(this) const {
    return str_from_parts(this->ptr, this->len);
}

void String.clear(this) {
    this->len = 0;
}

void String.reserve(this, isize n) {
    if (n <= this->cap) return;
    char* nd = (char*)realloc(this->ptr, n);
    if (!nd) __builtin_trap();
    this->ptr = nd;
    this->cap = n;
}

isize String.size(this) const {
    return this->len;
}

isize String.capacity(this) const {
    return this->cap;
}

bool String.is_empty(this) const {
    return this->len == 0;
}

void String.destroy(this) {
    free(this->ptr);
    this->ptr = (char*)0;
    this->len = 0;
    this->cap = 0;
}

String string_from_str(Str s) {
    String r;
    if (s.len == 0) {
        r.ptr = (char*)0;
        r.len = 0;
        r.cap = 0;
        return r;
    }
    r.len = s.len;
    r.cap = s.len;
    char* nd = (char*)malloc(r.cap);
    if (!nd) __builtin_trap();
    r.ptr = nd;
    isize i = 0;
    while (i < s.len) {
        r.ptr[i] = s.ptr[i];
        i = i + 1;
    }
    return r;
}

String string_from_parts(const char* sptr, isize slen) {
    Str tmp = str_from_parts(sptr, slen);
    return string_from_str(tmp);
}