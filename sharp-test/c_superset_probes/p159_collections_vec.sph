/* p159_collections_vec.h — Vec struct definitions for p159 test */

class Vec<T> {
    T *data;
    int len;
    int cap;
};

void Vec.push(this, T val) {
    if (this->len >= this->cap) {
        int new_cap = (this->cap == 0) ? 8 : this->cap * 2;
        this->data = (T *)realloc(this->data, sizeof(T) * new_cap);
        if (!this->data) __builtin_trap();
        this->cap = new_cap;
    }
    this->data[this->len] = val;
    this->len = this->len + 1;
}

int Vec.size(this) const {
    return this->len;
}

class String {
    char *data;
    int len;
};

int String.length(this) const {
    return this->len;
}