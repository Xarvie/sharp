/* p262_ringbuf.sph — Generic ring buffer module */

#include "../../std/types.sph"

class RingBuf<T> {
    T*    data;
    isize cap;
    isize head;
    isize tail;
    isize count;
};

void RingBuf<T>.init(this, T* buf, isize capacity) {
    this->data  = buf;
    this->cap   = capacity;
    this->head  = 0;
    this->tail  = 0;
    this->count = 0;
}

bool RingBuf<T>.push(this, T val) {
    if (this->count >= this->cap) return false;
    this->data[this->tail] = val;
    this->tail = (this->tail + 1) % this->cap;
    this->count = this->count + 1;
    return true;
}

bool RingBuf<T>.pop(this, T* out) {
    if (this->count == 0) return false;
    *out = this->data[this->head];
    this->head = (this->head + 1) % this->cap;
    this->count = this->count - 1;
    return true;
}

isize RingBuf<T>.size(this) const { return this->count; }