/* p161_std_vec.sph — std.vec definitions (monomorphized for int) */

#include <stdlib.h>

class Vec_int {
    int*    data;
    isize len;
    isize cap;
};

void Vec_int.push(this, int val) {
    if (this->len >= this->cap) {
        isize new_cap = (this->cap == 0) ? 8 : this->cap * 2;
        int* nd = (int*)realloc(this->data, sizeof(int) * new_cap);
        if (!nd) __builtin_trap();
        this->data = nd;
        this->cap = new_cap;
    }
    this->data[this->len] = val;
    this->len = this->len + 1;
}

int Vec_int.pop(this) {
    if (this->len == 0) __builtin_trap();
    this->len = this->len - 1;
    return this->data[this->len];
}

int Vec_int.get(this, isize i) const {
    if (i < 0 || i >= this->len) __builtin_trap();
    return this->data[i];
}

isize Vec_int.size(this) const {
    return this->len;
}

bool Vec_int.is_empty(this) const {
    return this->len == 0;
}

void Vec_int.destroy(this) {
    free(this->data);
    this->data = (int*)0;
    this->len = 0;
    this->cap = 0;
}