/* p163_genvec.sph — p163 Vec/Pair definitions (monomorphized for int/double) */

class Vec_int {
    int *data;
    int len;
    int cap;
};

void Vec_int.push(this, int val) {
    if (this->len >= this->cap) {
        int new_cap = (this->cap == 0) ? 8 : this->cap * 2;
        this->data = (int *)realloc(this->data, sizeof(int) * new_cap);
        if (!this->data) __builtin_trap();
        this->cap = new_cap;
    }
    this->data[this->len] = val;
    this->len = this->len + 1;
}

int Vec_int.get(this, int i) const {
    return this->data[i];
}

int Vec_int.size(this) const {
    return this->len;
}

class Pair_int_double {
    int first;
    double second;
};

int Pair_int_double.first_val(this) const {
    return this->first;
}

double Pair_int_double.second_val(this) const {
    return this->second;
}