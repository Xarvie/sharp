/* p158_math.h — Module definitions for p158 test */

/* ── Exported Functions ─────────────────────────────────────────────── */

int add(int a, int b) {
    return a + b;
}

float multiply(float x, float y) {
    return x * y;
}

void greet(char *name) {
    (void)name;
}

/* ── Exported Structs ───────────────────────────────────────────────── */

struct Point2D {
    float x;
    float y;
};

struct Rectangle {
    float width;
    float height;
    struct Point2D origin;
};

/* ── Exported Typedefs ──────────────────────────────────────────────── */

typedef int Int32;
typedef float Float32;

/* ── Exported Variables ─────────────────────────────────────────────── */

const double PI = 3.14159265358979323846;
int VERSION = 1;

/* ── Exported Enums ─────────────────────────────────────────────────── */

enum Color {
    RED,
    GREEN,
    BLUE
};

enum Status {
    OK = 0,
    ERROR = -1,
    PENDING = 1
};
enum Status DEFAULT_STATUS = OK;

/* ── Internal ───────────────────────────────────────── */

int internal_helper(int x) {
    return x * 2;
}
