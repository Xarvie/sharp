/* Clock & Timer — test: wg_set_timer, periodic updates, start/stop */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#include "webgui.he"

static wg_node_t *clock_display = NULL;
static wg_node_t *start_btn = NULL;
static wg_node_t *stop_btn  = NULL;
static int timer_id = 0;
static int elapsed  = 0;

static void update_clock(wg_app_t *app, void *ud) {
    (void)app; (void)ud;
    time_t now = time(NULL);
    struct tm *tm = localtime(&now);
    char buf[64];
    snprintf(buf, sizeof(buf), "%02d:%02d:%02d", tm->tm_hour, tm->tm_min, tm->tm_sec);
    wg_set_text(clock_display, buf);
}

static void tick_timer(wg_app_t *app, void *ud) {
    (void)app; (void)ud;
    elapsed++;
    char buf[32];
    snprintf(buf, sizeof(buf), "Elapsed: %ds", elapsed);
    wg_set_text(wg_find(app, "elapsed"), buf);
}

static void on_start(const wg_event_t *ev) {
    if (timer_id) return;  /* already running */
    timer_id = wg_set_timer(ev->app, 1000, 1, tick_timer, ev->app);
    elapsed = 0;
    wg_set_disabled(start_btn, 1);
    wg_set_disabled(stop_btn, 0);
}

static void on_stop(const wg_event_t *ev) {
    if (!timer_id) return;
    wg_clear_timer(ev->app, timer_id);
    timer_id = 0;
    wg_set_disabled(start_btn, 0);
    wg_set_disabled(stop_btn, 1);
}

int main(void) {
    wg_node_t *root = wg_container("root");
    wg_set_attr(root, "style", "max-width:300px;margin:40px auto;text-align:center;");

    wg_append(root, wg_heading("title", 2, "Clock & Timer"));

    /* Clock display */
    wg_append(root, wg_text("clock_label", "Current Time:"));
    clock_display = wg_text("clock", "00:00:00");
    wg_append(root, clock_display);

    /* Separator */
    wg_node_t *hr = wg_separator("hr");
    wg_append(root, hr);

    /* Timer display */
    wg_append(root, wg_text("elapsed_label", "Elapsed:"));
    wg_node_t *elapsed_display = wg_text("elapsed", "Elapsed: 0s");
    wg_append(root, elapsed_display);

    /* Control buttons */
    wg_node_t *btns = wg_container("btns");
    wg_set_attr(btns, "style", "display:flex;gap:8px;justify-content:center;");
    start_btn = wg_button("start", "Start");
    stop_btn  = wg_button("stop", "Stop");
    wg_set_disabled(stop_btn, 1);
    wg_append(btns, start_btn);
    wg_append(btns, stop_btn);
    wg_append(root, btns);

    wg_app_t *app = wg_app_create(root);
    if (!app) { fprintf(stderr, "wg_app_create failed\n"); return 1; }
    wg_bind_tcp(app, NULL, 9004);

    wg_set_title(app, "Clock & Timer Demo");

    /* Initial clock display */
    update_clock(NULL, NULL);

    /* Timer to update clock every second */
    wg_set_timer(app, 1000, 1, update_clock, NULL);

    /* Button handlers */
    wg_on(app, "start", "click", on_start, NULL);
    wg_on(app, "stop",  "click", on_stop,  NULL);

    printf("Open http://localhost:9004 in a browser.\n");
    wg_run(app);
    wg_app_destroy(app);
    return 0;
}
