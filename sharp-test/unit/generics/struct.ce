// Merged generic struct tests
// Sources: p101_generic_struct.ce, p103_generic_nested.ce, p104_generic_ptr.ce,
//          p105_generic_method.ce, p115_generic_struct_lit.ce, p107_generic_multitype.ce

/* Test 1: Single-param generic struct (p101) */
class Vec<T> {
    T data;
    int len;
}

/* Test 2: Multi-param generic struct (p103) */
class Pair<A, B> {
    A first;
    B second;
}

/* Test 3: Generic struct with pointer field (p104) */
class Box<T> {
    T* value;
}

/* Test 4: Generic struct with methods (p105) */
class Stack<T> {
    T top;
    int size;
}

int Stack<T>.push(this, T val) {
    this->top = val;
    this->size = this->size + 1;
    return this->size;
}

T Stack<T>.peek(this) const {
    return this->top;
}

T Stack<T>.last(this) const { return this->top; }

/* Test 5: Multi-type generic struct (p107) */
class Map<K, V> {
    K* keys;
    V* values;
    int count;
}

int main() {
    /* Test single-param generic (p101) */
    Vec<int> vi;
    vi.data = 42;
    vi.len = 1;
    if (vi.data != 42) return 1;
    if (vi.len != 1) return 2;

    Vec<float> vf;
    vf.data = 3.14f;
    vf.len = 1;
    if (vf.len != 1) return 3;

    /* Test multi-param generic (p103) */
    Pair<int, int> p;
    p.first = 10;
    p.second = 20;
    if (p.first != 10) return 4;
    if (p.second != 20) return 5;

    Pair<int, float> pif;
    pif.first = 7;
    pif.second = 1.5f;
    if (pif.first != 7) return 6;

    /* Test pointer field (p104) */
    int x = 100;
    Box<int> box;
    box.value = &x;
    if (box.value[0] != 100) return 7;

    /* Test generic methods (p105) */
    Stack<int> s;
    s.size = 0;
    s.push(42);
    if (s.peek() != 42) return 8;
    if (s.size != 1) return 9;
    s.push(99);
    if (s.peek() != 99) return 10;
    if (s.size != 2) return 11;

    /* Test struct literal syntax (p115) */
    Pair<int, float> lit = { .first = 7, .second = 3.14f };
    if (lit.first != 7) return 12;
    if (lit.second < 3.13f || lit.second > 3.15f) return 13;

    /* Test multi-type struct (p107) */
    Map<int, float> m;
    m.count = 5;
    if (m.count != 5) return 14;

    // --- T6: generic struct with const method returning field ---
    Stack<int> s2;
    s2.size = 0;
    s2.push(77);
    if (s2.last() != 77) return 15;
    if (s2.peek() != 77) return 16;

    // --- T7: generic struct zero-init ---
    Box<int> b2 = {0};
    if (b2.value != 0) return 17;

    return 0;
}
