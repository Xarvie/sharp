// Merged generic runtime monomorphization tests
// Sources: p268_runtime_generic.ce, p270_codegen_multi_inst.ce

typedef long isize;
typedef unsigned long usize;

/* Generic Pair with swap method (p268) */
class Pair<T> {
    T first;
    T second;
}

void Pair<T>.swap(this) {
    T tmp = this->first;
    this->first  = this->second;
    this->second = tmp;
}

/* Generic Wrap with set/get (p270) */
class Wrap<T> {
    T value;
}

void Wrap<T>.set(this, T v) { this->value = v; }
T    Wrap<T>.get(this) const { return this->value; }

Pair<T> Pair<T>.reversed(this) const {
    Pair<T> r;
    r.first = this->second;
    r.second = this->first;
    return r;
}

int main() {
    /* Test Pair<int> monomorphization (p268) */
    Pair<int> p;
    p.first  = 10;
    p.second = 20;

    if (p.first != 10) return 1;
    if (p.second != 20) return 2;

    p.swap();

    if (p.first != 20) return 3;
    if (p.second != 10) return 4;

    /* Test Pair<float> monomorphization (p268) */
    Pair<float> pf;
    pf.first  = 1.5f;
    pf.second = 2.5f;

    if (pf.first != 1.5f) return 5;
    if (pf.second != 2.5f) return 6;

    pf.swap();

    if (pf.first != 2.5f) return 7;
    if (pf.second != 1.5f) return 8;

    /* Test multiple instantiations coexistence (p270) */
    Wrap<int> wi;
    wi.set(42);
    if (wi.get() != 42) return 9;

    Wrap<float> wf;
    wf.set(3.14f);
    if (wf.get() != 3.14f) return 10;

    /* Two different instantiations, same file */
    Wrap<int> wi2;
    wi2.set(99);
    if (wi2.get() != 99) return 11;

    // --- T3: generic method returning generic type ---
    Pair<int> p2 = {10, 20};
    Pair<int> rev = p2.reversed();
    if (rev.first != 20) return 12;
    if (rev.second != 10) return 13;

    // --- T4: multiple generic instances in same expression ---
    Wrap<int> w1; w1.set(5);
    Wrap<int> w2; w2.set(10);
    if (w1.get() + w2.get() != 15) return 14;

    return 0;
}
