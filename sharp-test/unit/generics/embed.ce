// Merged generic zero-init and embed tests
// Sources: p235_generic_zeroinit.ce, p237_generic_embed.ce

#include <stdbool.h>

/* Generic struct with zero-init (p235) */
class Maybe<T> {
    bool has;
    T    val;
}

bool Maybe<T>.has_val(this) const { return this->has; }
T    Maybe<T>.get_val(this) const { return this->val; }
void Maybe<T>.set_val(this, T v) { this->has = true; this->val = v; }

/* Generic struct embedding bare struct (p237) */
class Point {
    int x;
    int y;
}

class Labeled<T> {
    T     label;
    Point pos;
}

T    Labeled<T>.get_label(this) const { return this->label; }
void Labeled<T>.set_label(this, T val) { this->label = val; }
void Labeled<T>.set_xy(this, int x, int y) { this->pos.x = x; this->pos.y = y; }
int  Labeled<T>.pos_x(this) const { return this->pos.x; }
int  Labeled<T>.move_x(this, int dx) { this->pos.x = this->pos.x + dx; return this->pos.x; }

int main() {
    /* Test zero-init (p235) */
    Maybe<int> mi = {0};
    if (mi.has_val()) return 1;

    mi.set_val(42);
    if (!mi.has_val()) return 2;
    if (mi.get_val() != 42) return 3;

    Maybe<float> mf = {0};
    if (mf.has_val()) return 4;

    mf.set_val(1.5f);
    if (mf.get_val() < 1.49f || mf.get_val() > 1.51f) return 5;

    /* Test embed bare struct (p237) */
    Labeled<int> a = {0};
    a.set_label(42);
    a.set_xy(10, 20);

    if (a.get_label() != 42) return 6;
    if (a.pos_x() != 10) return 7;

    Labeled<float> b = {0};
    b.set_label(3.14f);
    if (b.get_label() < 3.13f || b.get_label() > 3.15f) return 8;

    // --- T3: nested Maybe pattern ---
    Maybe<Maybe<int>> outer = {0};
    if (outer.has_val()) return 9;
    Maybe<int> inner = {0};
    inner.set_val(42);
    outer.set_val(inner);
    if (!outer.has_val()) return 10;
    Maybe<int> retrieved = outer.get_val();
    if (!retrieved.has_val()) return 11;
    if (retrieved.get_val() != 42) return 12;

    // --- T4: Labeled with method chaining ---
    Labeled<int> c = {0};
    c.set_label(99);
    c.set_xy(5, 10);
    if (c.move_x(3) != 8) return 13;
    if (c.pos_x() != 8) return 14;

    return 0;
}
