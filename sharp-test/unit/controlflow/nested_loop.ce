// 控制流: 嵌套循环和 break/continue 测试

int main() {
    // T1: 嵌套 for 循环矩阵遍历
    int mat[3][3] = {{0}};
    for (int i = 0; i < 3; i = i + 1)
        for (int j = 0; j < 3; j = j + 1)
            mat[i][j] = i * 3 + j;
    if (mat[0][0] != 0) return 1;
    if (mat[1][2] != 5) return 2;
    if (mat[2][2] != 8) return 3;

    // T2: break 跳出内层循环
    int found_i = -1, found_j = -1;
    for (int i = 0; i < 3; i = i + 1) {
        for (int j = 0; j < 3; j = j + 1) {
            if (mat[i][j] == 5) {
                found_i = i;
                found_j = j;
                break;
            }
        }
    }
    if (found_i != 1 || found_j != 2) return 4;

    // T3: continue 跳过偶数
    int odd_sum = 0;
    for (int i = 0; i < 10; i = i + 1) {
        if (i % 2 == 0) continue;
        odd_sum = odd_sum + i;
    }
    if (odd_sum != 25) return 5;  // 1+3+5+7+9

    // T4: while 嵌套 break
    int count = 0;
    int i = 0;
    while (i < 10) {
        int j = 0;
        while (j < 10) {
            count = count + 1;
            if (j == 2) break;
            j = j + 1;
        }
        i = i + 1;
    }
    if (count != 30) return 6;  // 10 * 3

    // T5: do-while 嵌套 continue
    int sum = 0;
    int k = 0;
    do {
        if (k % 3 == 0) { k = k + 1; continue; }
        sum = sum + k;
        k = k + 1;
    } while (k < 10);
    if (sum != 27) return 7;  // 1+2+4+5+7+8

    return 0;
}
