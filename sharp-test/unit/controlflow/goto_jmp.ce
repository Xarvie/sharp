// 来源: p259_goto.ce
// goto 和 label 控制流: 基础 + goto+defer交互 + 嵌套跳转 + switch中goto

int log_buf[32];
int logn = 0;
void mark(int v) { log_buf[logn++] = v; }

int main() {
    // T1: forward goto
    int x = 0;
    goto L_set;
    x = 99;
L_set:
    x = 42;
    if (x != 42) return 1;

    // T2: backward goto (loop-like)
    int count = 0, i = 0;
L_loop:
    if (i >= 5) goto L_done;
    count = count + i;
    i = i + 1;
    goto L_loop;
L_done:
    if (count != 10) return 2;  /* 0+1+2+3+4 */

    // T3: goto bypassing declaration
    int y = 5;
    goto L_skip_decl;
    {
        int local = 99;
        (void)local;
    }
L_skip_decl:
    if (y != 5) return 3;

    // T4: multiple labels
    int val = 0;
    if (val == 0) goto L_A;
    goto L_B;
L_A:
    val = 1;
    goto L_C;
L_B:
    val = 2;
    goto L_C;
L_C:
    if (val != 1) return 4;

    // T5: goto out of nested scope
    {
        int nested = 10;
        {
            int deep = 20;
            if (deep == 20) goto L_out_nested;
            nested = 99;
        }
    }
L_out_nested:
    val = 55;
    if (val != 55) return 5;

    // T6: goto out of nested scope (no defer crossing)
    {
        int nested = 10;
        {
            int deep = 20;
            if (deep == 20) goto L_out_nested2;
            nested = 99;
        }
    }
L_out_nested2:
    val = 66;
    if (val != 66) return 6;

    // T7: goto in switch
    int sw_val = 0;
    switch (2) {
        case 1: sw_val = 10; break;
        case 2: sw_val = 20; goto L_after_switch;
        case 3: sw_val = 30; break;
    }
    sw_val = sw_val + 100;
L_after_switch:
    if (sw_val != 20) return 8;

    // T8: computed jump pattern (state machine via goto)
    int state = 0;
    int result = 0;
L_state_0:
    result = result + 1;
    state = 1;
    goto L_state_1;
L_state_1:
    result = result + 10;
    state = 2;
    goto L_state_2;
L_state_2:
    result = result + 100;
    goto L_state_done;
L_state_done:
    if (result != 111) return 9;

    return 0;
}
