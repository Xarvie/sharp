// 来源: p261_module_cross.ce
// 模块交叉引用: 导入带有类和扩展方法的模块

#include "cross_ref.he"

int distance_sq(class Point2D a, class Point2D b) {
    int dx = a.get_x() - b.get_x();
    int dy = a.get_y() - b.get_y();
    return dx * dx + dy * dy;
}

int main() {
    class Point2D p1;
    p1.move_to(0, 0);

    class Point2D p2;
    p2.move_to(3, 4);

    int d = distance_sq(p1, p2);
    if (d != 25) return 1;  /* 3*3 + 4*4 = 25 */

    if (p1.get_x() != 0) return 2;
    if (p1.get_y() != 0) return 3;
    if (p2.get_x() != 3) return 4;
    if (p2.get_y() != 4) return 5;

    // --- T2: method chaining across module ---
    class Point2D p3;
    p3.move_to(10, 20);
    p3.move_to(p3.get_x() + 5, p3.get_y() + 5);
    if (p3.get_x() != 15) return 6;
    if (p3.get_y() != 25) return 7;

    // --- T3: distance between moved points ---
    class Point2D p4;
    p4.move_to(15, 25);
    int d2 = distance_sq(p3, p4);
    if (d2 != 0) return 8;

    return 0;
}