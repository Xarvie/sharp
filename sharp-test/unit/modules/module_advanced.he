#include <stdbool.h>

typedef long isize;

class RingBuf<T> {
    T*    data;
    isize cap;
    isize head;
    isize tail;
    isize count;
};

void RingBuf<T>.init(this, T* buf, isize capacity) {
    this->data  = buf;
    this->cap   = capacity;
    this->head  = 0;
    this->tail  = 0;
    this->count = 0;
}

bool RingBuf<T>.push(this, T val) {
    if (this->count >= this->cap) return false;
    this->data[this->tail] = val;
    this->tail = (this->tail + 1) % this->cap;
    this->count = this->count + 1;
    return true;
}

bool RingBuf<T>.pop(this, T* out) {
    if (this->count == 0) return false;
    *out = this->data[this->head];
    this->head = (this->head + 1) % this->cap;
    this->count = this->count - 1;
    return true;
}

T RingBuf<T>.peek(this) const {
    return this->data[this->head];
}

void RingBuf<T>.clear(this) {
    this->head  = 0;
    this->tail  = 0;
    this->count = 0;
}

isize RingBuf<T>.size(this) const { return this->count; }
isize RingBuf<T>.capacity(this) const { return this->cap; }
bool RingBuf<T>.is_empty(this) const { return this->count == 0; }
bool RingBuf<T>.is_full(this) const { return this->count >= this->cap; }

T clamp_val<T>(T val, T lo, T hi) {
    if (val < lo) return lo;
    if (val > hi) return hi;
    return val;
}

enum BufStatus { BUF_OK = 0, BUF_FULL = 1, BUF_EMPTY = 2, BUF_ERROR = -1 };
