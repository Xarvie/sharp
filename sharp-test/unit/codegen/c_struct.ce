// 来源: pc00220_c_struct_bare.ce, p218_to_cstr.ce, p221_std_include.ce
// C代码生成: C struct(裸名) + 标准库include + C字符串转换

#include <stdlib.h>
#include <stdbool.h>

typedef long isize;

// === pc00220: C struct bare name usage ===
struct CIface {
    void *userdata;
    int refcount;
    struct CIface *next;
};

void reset_refcount(CIface *c) {
    c->refcount = 0;
    c->next = (CIface *)0;
}
CIface *create_c_iface(void) {
    CIface *p = (CIface *)malloc(sizeof(CIface));
    p->userdata = 0;
    p->refcount = 0;
    p->next = 0;
    return p;
}

// === p218: C string conversion (simplified, inline) ===
class Str {
    const char* ptr;
    isize       len;
};
isize Str.size(this) const { return this->len; }
struct Str str_from_lit(const char* lit) {
    struct Str s;
    s.ptr = lit;
    s.len = 0;
    while (lit[s.len] != 0) s.len = s.len + 1;
    return s;
}
struct Str str_from_parts(const char* p, isize len) {
    struct Str s;
    s.ptr = p;
    s.len = len;
    return s;
}
const char *to_cstr_manual(struct Str s) {
    static char buf[4096];
    isize i = 0;
    while (i < s.size()) { buf[i] = s.ptr[i]; i = i + 1; }
    buf[i] = '\0';
    return buf;
}

// === p221: Vec-like container (simplified, inline) ===
class Vec_int {
    int*    data;
    isize len;
    isize cap;
};
void Vec_int.push(this, int val) {
    if (this->len >= this->cap) {
        isize nc = (this->cap == 0) ? 8 : this->cap * 2;
        this->data = (int*)realloc(this->data, nc * sizeof(int));
        this->cap = nc;
    }
    this->data[this->len] = val;
    this->len = this->len + 1;
}
int Vec_int.get(this, isize i) const { return this->data[i]; }
isize Vec_int.size(this) const { return this->len; }
void Vec_int.destroy(this) { free(this->data); }

int main(void) {
    // --- pc00220: C struct bare name ---
    CIface *c = create_c_iface();
    reset_refcount(c);
    free(c);

    // --- p218: C string ---
    struct Str hello = str_from_lit("Hello");
    if (hello.size() != 5) return 1;
    const char *cstr = to_cstr_manual(hello);
    if (cstr[5] != '\0') return 2;
    if (cstr[0] != 'H') return 3;
    struct Str empty = str_from_parts(hello.ptr, 0);
    if (empty.size() != 0) return 4;

    // --- p221: Vec test ---
    Vec_int vi;
    vi.data = NULL; vi.len = 0; vi.cap = 0;
    vi.push(42);
    vi.push(73);
    if (vi.size() != 2) return 5;
    if (vi.get(0) != 42) return 6;
    if (vi.get(1) != 73) return 7;
    vi.destroy();

    // --- T3: C struct with linked list pattern ---
    struct CIface head = {0};
    struct CIface second = {0};
    head.userdata = (void*)0;
    head.refcount = 1;
    head.next = &second;
    second.userdata = (void*)0;
    second.refcount = 2;
    second.next = (struct CIface*)0;
    if (head.next->refcount != 2) return 8;
    if (head.next->next != (struct CIface*)0) return 9;

    return 0;
}