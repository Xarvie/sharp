// C代码生成: 位域测试
struct Flags {
    unsigned int a : 1;
    unsigned int b : 3;
    unsigned int c : 4;
    unsigned int d : 8;
};

int main() {
    // T1: 位域读写
    struct Flags f;
    f.a = 1;
    f.b = 5;
    f.c = 10;
    f.d = 200;
    if (f.a != 1) return 1;
    if (f.b != 5) return 2;
    if (f.c != 10) return 3;
    if (f.d != 200) return 4;

    // T2: 位域溢出截断
    f.b = 15;
    if (f.b != 7) return 5;  // 3位最大7

    // T3: 位域在条件中
    if (!f.a) return 6;
    f.a = 0;
    if (f.a) return 7;

    // T4: 位域赋值表达式
    struct Flags g = {0};
    g.a = f.a;
    g.b = f.b;
    if (g.a != 0) return 8;
    if (g.b != 7) return 9;

    return 0;
}
