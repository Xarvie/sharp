// 来源: p225_operator_extension.ce, p267_runtime_operator.ce
// 运算符作为扩展方法 + 运行时运算符重载测试

#include <stdbool.h>

// === p225: 运算符扩展方法 + 作用域测试 ===
class Pt {
    int x;
    int y;
};

// 在运算符定义之前使用
int test_before() {
    Pt a; a.x = 1; a.y = 2;
    Pt b; b.x = 10; b.y = 20;
    Pt c = a + b;
    if (c.x != 11) return 1;
    if (c.y != 22) return 2;
    return 0;
}

// 运算符扩展方法定义
Pt Pt.operator+(this, Pt other) const {
    Pt r;
    r.x = this->x + other.x;
    r.y = this->y + other.y;
    return r;
}

// 在运算符定义之后使用
int test_after() {
    Pt a; a.x = 5; a.y = 6;
    Pt b; b.x = 30; b.y = 40;
    Pt c = a + b;
    if (c.x != 35) return 11;
    if (c.y != 46) return 12;
    return 0;
}

// === p267: 运行时运算符重载 (+,-,链式) ===
class Point {
    int x;
    int y;
};
Point Point.operator+(this, Point rhs) {
    Point r;
    r.x = this->x + rhs.x;
    r.y = this->y + rhs.y;
    return r;
}
Point Point.operator-(this, Point rhs) {
    Point r;
    r.x = this->x - rhs.x;
    r.y = this->y - rhs.y;
    return r;
}

bool Pt.operator==(this, Pt other) const {
    return this->x == other.x && this->y == other.y;
}

int main() {
    // --- p225 测试 ---
    int r1 = test_before();
    if (r1 != 0) return r1;
    int r2 = test_after();
    if (r2 != 0) return r2;

    // --- p267 测试 ---
    Point p1; p1.x = 3; p1.y = 5;
    Point p2; p2.x = 7; p2.y = 2;

    Point r_add = p1 + p2;
    if (r_add.x != 10) return 21;
    if (r_add.y != 7)  return 22;

    Point r_sub = p1 - p2;
    if (r_sub.x != -4) return 23;
    if (r_sub.y != 3)  return 24;

    // 链式运算符
    Point p3; p3.x = 1; p3.y = 1;
    Point r_chain = p1 + p2 + p3;
    if (r_chain.x != 11) return 25;
    if (r_chain.y != 8)  return 26;

    // --- T3: extension operator with const ---
    Pt pa; pa.x = 3; pa.y = 5;
    Pt pb; pb.x = 3; pb.y = 5;
    if (!(pa == pb)) return 27;

    // --- T4: extension operator in conditional ---
    Pt pc; pc.x = 1; pc.y = 2;
    if (pa == pc) return 28;
    if (!(pa == pb)) return 29;

    return 0;
}