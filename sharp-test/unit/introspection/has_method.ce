// 来源: p250_has_method.ce, p251_has_field.ce, p252_is_arithmetic.ce
// @has_method + @has_field + @is_arithmetic 编译期内省测试

#include <stdbool.h>

// === p250: @has_method ===
class Foo {
    int x;
};
int Foo.get_x(this) { return this->x; }

// === p251: @has_field ===
class Inner {
    int a;
};
class Outer {
    Inner inner;
    int   b;
};

// === p252: @is_arithmetic ===
typedef int MyInt;
typedef float MyFloat;
typedef long isize;
class Point { int x; int y; };

class WithDebug {
    int val;
};
void WithDebug.debug_print(this) { (void)this; }
int WithDebug.get_val(this) { return this->val; }

class NoDebug {
    int val;
};
int NoDebug.get_val(this) { return this->val; }

int main() {
    // --- p250: @has_method ---
    Foo f; f.x = 42;
    if (@has_method(Foo, get_x)) {
        if (f.get_x() != 42) return 1;
    } else { return 10; }
    if (@has_method(Foo, missing_method)) { return 20; }
    @static_assert(@has_method(Foo, get_x), "Foo must have get_x");

    // --- p251: @has_field ---
    Outer o = {0};
    if (@has_field(Outer, inner)) { o.inner.a = 1; } else { return 30; }
    if (@has_field(Outer, b)) { o.b = 2; } else { return 40; }
    if (@has_field(Inner, a)) { } else { return 50; }
    if (@has_field(Outer, missing)) { return 60; }
    @static_assert(@has_field(Outer, inner), "Outer must have inner");
    if (o.inner.a != 1) return 2;
    if (o.b != 2) return 3;

    // --- p252: @is_arithmetic ---
    if (@is_arithmetic(MyInt)) { } else { return 70; }
    if (@is_arithmetic(MyFloat)) { } else { return 80; }
    if (@is_arithmetic(Point)) { return 90; }
    if (@is_arithmetic(isize)) { } else { return 100; }
    @static_assert(@is_arithmetic(int), "int must be arithmetic");

    // --- T4: conditional method dispatch based on introspection ---
    WithDebug wd; wd.val = 42;
    NoDebug nd; nd.val = 99;

    if (@has_method(WithDebug, debug_print)) {
        wd.debug_print();
    }
    if (@has_method(NoDebug, debug_print)) {
        return 110;
    }
    if (wd.get_val() != 42) return 111;
    if (nd.get_val() != 99) return 112;

    return 0;
}