-- sp-mysql-client — MySQL/MariaDB client library for Sharp ecosystem
--
-- Clean-room implementation of the MySQL wire protocol (text + binary).
-- Depends on mbedTLS (TLS/RSA), zlib (CLIENT_COMPRESS), zstd (CLIENT_ZSTD_COMPRESSION).

b:dep("mbedtls2", { version = "*" })
b:dep("zlib",     { version = "*" })
b:dep("zstd",     { version = "*" })

local mbedtls_dir = "spkg_packages/mbedtls2"
local zlib_dir     = "spkg_packages/zlib"
local zstd_dir     = "spkg_packages/zstd"

-- Layer 0: mbedTLS — TLS/RSA support
local mbedtls = b:add_static_library({ name = "mbedtls" })

local mb_srcs = {
    "aes", "aesni", "arc4", "aria", "asn1parse", "asn1write",
    "base64", "bignum", "blowfish", "camellia", "ccm", "certs",
    "chacha20", "chachapoly", "cipher", "cipher_wrap", "cmac",
    "constant_time", "ctr_drbg", "debug", "des", "dhm",
    "ecdh", "ecdsa", "ecjpake", "ecp", "ecp_curves",
    "entropy", "entropy_poll", "error", "gcm", "havege",
    "hkdf", "hmac_drbg", "md2", "md4", "md5", "md",
    "memory_buffer_alloc", "mps_reader", "mps_trace",
    "net_sockets", "nist_kw", "oid", "padlock", "pem",
    "pk", "pkcs11", "pkcs12", "pkcs5", "pkparse", "pk_wrap",
    "pkwrite", "platform", "platform_util", "poly1305",
    "psa_crypto_aead", "psa_crypto", "psa_crypto_cipher",
    "psa_crypto_client", "psa_crypto_driver_wrappers",
    "psa_crypto_ecp", "psa_crypto_hash", "psa_crypto_mac",
    "psa_crypto_rsa", "psa_crypto_se", "psa_crypto_slot_management",
    "psa_crypto_storage", "psa_crypto_its_file",
    "ripemd160", "rsa", "rsa_internal",
    "sha1", "sha256", "sha512",
    "ssl_cache", "ssl_ciphersuites", "ssl_cli", "ssl_cookie",
    "ssl_msg", "ssl_srv", "ssl_ticket", "ssl_tls13_keys", "ssl_tls",
    "threading", "timing", "version", "version_features",
    "x509", "x509_create", "x509_crl", "x509_crt", "x509_csr",
    "x509write_crt", "x509write_csr", "xtea"
}
for _, name in ipairs(mb_srcs) do
    mbedtls:add_source({ file = mbedtls_dir .. "/library/" .. name .. ".c" })
end
mbedtls:add_include(mbedtls_dir .. "/include")
mbedtls:add_include(mbedtls_dir .. "/library")
b:install(mbedtls)

-- Layer 1: zlib — compression (CLIENT_COMPRESS)
local zlib = b:add_static_library({ name = "zlib" })

zlib:add_source({ file = zlib_dir .. "/adler32.c" })
zlib:add_source({ file = zlib_dir .. "/compress.c" })
zlib:add_source({ file = zlib_dir .. "/crc32.c" })
zlib:add_source({ file = zlib_dir .. "/deflate.c" })
zlib:add_source({ file = zlib_dir .. "/inflate.c" })
zlib:add_source({ file = zlib_dir .. "/inffast.c" })
zlib:add_source({ file = zlib_dir .. "/inftrees.c" })
zlib:add_source({ file = zlib_dir .. "/trees.c" })
zlib:add_source({ file = zlib_dir .. "/uncompr.c" })
zlib:add_source({ file = zlib_dir .. "/zutil.c" })
zlib:add_source({ file = zlib_dir .. "/gzclose.c" })
zlib:add_source({ file = zlib_dir .. "/gzlib.c" })
zlib:add_source({ file = zlib_dir .. "/gzread.c" })
zlib:add_source({ file = zlib_dir .. "/gzwrite.c" })
zlib:add_source({ file = zlib_dir .. "/infback.c" })

zlib:add_include(zlib_dir)
zlib:add_define("_GNU_SOURCE")
b:install(zlib)

-- Layer 2: zstd — compression (CLIENT_ZSTD_COMPRESSION)
local zstd = b:add_static_library({ name = "zstd" })

local zstd_D = zstd_dir .. "/lib"

local common_srcs = {
    "debug", "entropy_common", "error_private",
    "fse_decompress", "pool", "threading",
    "xxhash", "zstd_common"
}
for _, name in ipairs(common_srcs) do
    zstd:add_source({ file = zstd_D .. "/common/" .. name .. ".c" })
end

local compress_srcs = {
    "fse_compress", "hist", "huf_compress",
    "zstd_compress", "zstd_compress_literals",
    "zstd_compress_sequences", "zstd_compress_superblock",
    "zstd_double_fast", "zstd_fast", "zstd_lazy",
    "zstd_ldm", "zstd_opt", "zstdmt_compress",
    "zstd_preSplit"
}
for _, name in ipairs(compress_srcs) do
    zstd:add_source({ file = zstd_D .. "/compress/" .. name .. ".c" })
end

local decompress_srcs = {
    "huf_decompress", "zstd_ddict",
    "zstd_decompress", "zstd_decompress_block"
}
for _, name in ipairs(decompress_srcs) do
    zstd:add_source({ file = zstd_D .. "/decompress/" .. name .. ".c" })
end

local dict_srcs = { "cover", "divsufsort", "fastcover", "zdict" }
for _, name in ipairs(dict_srcs) do
    zstd:add_source({ file = zstd_D .. "/dictBuilder/" .. name .. ".c" })
end

zstd:add_include(zstd_D)
zstd:add_include(zstd_D .. "/common")
zstd:add_include(zstd_D .. "/dictBuilder")
zstd:add_define("XXH_NAMESPACE=ZSTD_")
zstd:add_define("ZSTD_LEGACY_SUPPORT=0")
zstd:add_define("ZSTD_MULTITHREAD")
zstd:add_define("ZSTD_DISABLE_ASM")
zstd:add_define("ZSTD_NO_INTRINSICS")
zstd:add_define("MEM_FORCE_MEMORY_ACCESS=0")
b:install(zstd)

-- Layer 3: sp-mysql-client — MySQL/MariaDB client library
local sp_mysql_client = b:add_static_library({ name = "sp-mysql-client" })

sp_mysql_client:add_source({ file = "src/sha.c" })
sp_mysql_client:add_source({ file = "src/transport.c" })
sp_mysql_client:add_source({ file = "src/mysql_client.c" })
sp_mysql_client:add_source({ file = "src/mysql_pool.c" })

sp_mysql_client:add_include("include")
sp_mysql_client:add_include("src")
sp_mysql_client:add_include(mbedtls_dir .. "/include")
sp_mysql_client:add_include(zlib_dir)
sp_mysql_client:add_include(zstd_D)

sp_mysql_client:link_artifact(mbedtls)
sp_mysql_client:link_artifact(zlib)
sp_mysql_client:link_artifact(zstd)
sp_mysql_client:add_define("_GNU_SOURCE")

b:install(sp_mysql_client)

-- Test executable
local test_exe = b:add_executable({ name = "test_integration" })
test_exe:add_source({ file = "test_integration.c" })
test_exe:add_include("include")
test_exe:add_include("src")
test_exe:add_include(mbedtls_dir .. "/include")
test_exe:add_include(zlib_dir)
test_exe:add_include(zstd_D)
test_exe:link_artifact(sp_mysql_client)
test_exe:add_define("_GNU_SOURCE")
test_exe:link_library("pthread")
b:install(test_exe)
