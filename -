# 1 "sharp-test/c_superset_probes/p66_abstract_fnptr_cast.c"
typedef int uid_t;
typedef long gid_t;
static int counter = 0;
static int my_call(int a, uid_t b, gid_t c) {
    counter += a + (int)b + (int)c;
    return 0;
}
int main(void) {
    void *fp = (void *)my_call;
    int r = ((int(*)(int, uid_t, gid_t))fp)(7, 11, 22);
    return r + counter - 40; 
}
